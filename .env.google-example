# Google OAuth Configuration Example
# Add these values to your .env file after getting credentials from Google Cloud Console

# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/
GOOGLE_OAUTH2_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your_google_client_secret_here

# Example for local development:
# GOOGLE_OAUTH2_CLIENT_ID=123456789-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
# GOOGLE_OAUTH2_CLIENT_SECRET=GOCSPX-1234567890abcdefghijklmno

# The redirect URLs you need to configure in Google Console:
# Development: http://localhost:8000/accounts/google/login/callback/
# Production: https://yourdomain.com/accounts/google/login/callback/
